# Environment Configuration for LedgerOS

# Application
LEDGEROS_ENV=development
LEDGEROS_SECRET_KEY=ledgeros-dev-super-secret-key-32chars
LEDGEROS_PORT=8000
LEDGEROS_HOST=0.0.0.0

# Database (Default local SQLite async, or Neon PostgreSQL in production)
# Example Postgres: postgresql+psycopg://user:password@ep-xyz.us-east-2.aws.neon.tech/ledgeros?sslmode=require
DATABASE_URL=sqlite+aiosqlite:///./ledgeros.db

# Redis / Queue (Optional in dev, Upstash in prod)
# REDIS_URL=rediss://default:token@upstash.io:6379

# LLM Providers (LiteLLM handles fallbacks)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM_MODEL=gemini/gemini-2.5-flash

# Razorpay Test Mode
RAZORPAY_KEY_ID=rzp_test_TedMYIJ6GqxOIK
RAZORPAY_KEY_SECRET=WX6wGdtkKE1GBeRK07gL6JN3
RAZORPAY_WEBHOOK_SECRET=dummywebhooksecret789

# FinRCA Benchmark Data Location
FINRCA_DATA_DIR=external/FinRCA-AI-Bench/data/benchmark

# Supabase (Auth, JWKS, & Postgres)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
